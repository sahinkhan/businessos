BOS_ENVIRONMENT=development
BOS_HOST=0.0.0.0
BOS_PORT=8000
BOS_LOG_LEVEL=INFO
BOS_INSTALLATION_ID=00000000-0000-0000-0000-000000000001
# Protected deployment path visible inside the container/process; mount an
# operator-approved inventory there before enabling classification ownership.
BOS_APPROVED_MODULE_INVENTORY=
BOS_DATABASE_URL=postgresql+psycopg://businessos_app:businessos-application@localhost:5432/businessos
BOS_GOVERNANCE_DATABASE_URL=postgresql+psycopg://businessos_governance:businessos-governance@localhost:5432/businessos
BOS_GOVERNANCE_PASSWORD=businessos-governance
BOS_MIGRATION_DATABASE_URL=postgresql+psycopg://businessos_migrator:businessos-migration@localhost:5432/businessos
BOS_OPERATIONAL_DATABASE_URL=postgresql+psycopg://businessos_ops:businessos-operations@localhost:5432/businessos
BOS_DATABASE_POOL_SIZE=5
BOS_DATABASE_POOL_TIMEOUT_SECONDS=10
BOS_GOVERNANCE_DATABASE_POOL_SIZE=2
BOS_GOVERNANCE_DATABASE_POOL_TIMEOUT_SECONDS=10
# Set these to the installation's deployed process and reserved connection counts.
# The budget must fit PostgreSQL max_connections at startup.
BOS_DATABASE_CONNECTION_BUDGET=100
BOS_DATABASE_APP_PROCESSES=1
BOS_DATABASE_WORKER_POOL_RESERVATION=5
BOS_DATABASE_OPS_POOL_RESERVATION=2
BOS_DATABASE_OTHER_CONNECTION_RESERVATION=10
BOS_DATABASE_READINESS_ENABLED=true
BOS_REQUEST_BODY_LIMIT_BYTES=1048576
BOS_S3_BUCKET=businessos-development
BOS_S3_ENDPOINT_URL=http://localhost:9000
BOS_S3_REGION_NAME=us-east-1
BOS_S3_ACCESS_KEY=businessos
BOS_S3_SECRET_KEY=businessos-development
BOS_S3_PROVISION_BUCKET=true
BOS_TEST_DATABASE_ADMIN_URL=postgresql://businessos_migrator:businessos-migration@localhost:5432/postgres
BOS_TEST_DATABASE_RUNTIME_URL=postgresql://businessos_app:businessos-application@localhost:5432/postgres
BOS_TEST_DATABASE_OPERATIONS_URL=postgresql://businessos_ops:businessos-operations@localhost:5432/postgres
BOS_TEST_REDIS_URL=redis://localhost:6379/0
BOS_TEST_NATS_URL=nats://localhost:4222
BOS_TEST_S3_ENDPOINT=http://localhost:9000
BOS_TEST_S3_ACCESS_KEY=businessos
BOS_TEST_S3_SECRET_KEY=businessos-development
